{
  "name": "resumaker",
  "version": "0.0.1",
  "private": true,
  "description": "Hebrew-first AI resume builder with ATS optimization",
  "author": "Resumaker Team",
  "license": "BUSL-1.1",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @resumaker/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter tests-e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "security:secrets": "gitleaks detect --source . --verbose",
    "security:deps": "pnpm audit --audit-level=high --prod",
    "security:iac": "trivy config infra/",
    "security:all": "pnpm security:secrets && pnpm security:deps && pnpm security:iac",
    "infra:fmt": "tofu -chdir=infra/tofu fmt -recursive",
    "infra:validate": "tofu -chdir=infra/tofu validate",
    "infra:plan:dev": "tofu -chdir=infra/tofu/environments/dev plan",
    "prepare": "pre-commit install || true"
  },
  "devDependencies": {
    "globals": "^16",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "vite": ">=6.4.3 <7",
      "@opentelemetry/core": ">=2.8.0",
      "@babel/core": ">=7.29.6",
      "js-yaml@^3.0.0": ">=3.15.0 <4",
      "js-yaml@^4.0.0": ">=4.2.0 <5",
      "brace-expansion@^1.0.0": ">=1.1.16 <2",
      "brace-expansion@^5.0.0": ">=5.0.7 <6"
    }
  }
}
