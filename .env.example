# ════════════════════════════════════════════════════════════
# RESUMAKER — Environment Configuration Template
# ────────────────────────────────────────────────────────────
# Copy this file to `apps/web/.env` and fill in real values.
# Production secrets live in AWS Secrets Manager (resumaker-prod/app).
# NEVER commit .env to git.
# ════════════════════════════════════════════════════════════

# ─── Application ───
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

# ─── Database ───
# Local dev: `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=devpass postgres:17-alpine`
DATABASE_URL=postgres://resumaker:devpass@localhost:5432/resumaker
DATABASE_POOL_MAX=10

# ─── Redis ───
# Set to `disabled` in local dev to use the in-memory rate-limit fallback
# (no Docker container needed). Production uses ElastiCache via tofu.
REDIS_URL=disabled

# ─── Better Auth ───
# Generate: `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-48-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# Privacy: HMAC salt for hashing IPs in audit_log. Rotate yearly in prod.
# Falls back to BETTER_AUTH_SECRET if unset — fine for dev.
# Generate: `openssl rand -base64 48`
IP_HASH_SALT=

# OAuth providers — optional, leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── LLM (Anthropic) ───
ANTHROPIC_API_KEY=sk-ant-api03-...

DEFAULT_LLM_MODEL=claude-sonnet-4-6
FALLBACK_LLM_MODEL=claude-haiku-4-5
PARSE_LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY_LIMIT=20

# ─── AI Safety ───
PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

# ─── AWS ───
AWS_REGION=il-central-1
AWS_S3_BUCKET=

# ─── Payment provider ───
# 'none' | 'stripe' | 'lemonsqueezy'
# Defaults to 'none' so pricing page shows waitlist CTA.
PAYMENT_PROVIDER=none

# Stripe (only when PAYMENT_PROVIDER=stripe) — fill price IDs from dashboard
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PLUS_QUARTERLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_QUARTERLY=

# LemonSqueezy (only when PAYMENT_PROVIDER=lemonsqueezy)
# Variant IDs come from your LS dashboard after creating products.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PLUS_MONTHLY=
LEMONSQUEEZY_VARIANT_PLUS_YEARLY=
LEMONSQUEEZY_VARIANT_PLUS_QUARTERLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_QUARTERLY=

# ─── Email (Resend) ───
# Optional in dev — leave blank to log emails to console instead of sending
RESEND_API_KEY=
EMAIL_FROM=noreply@resumaker.co.il

# ─── Observability (Sentry) ───
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=pretty

# ─── Cron ───
# Generate: `openssl rand -base64 32`
CRON_SECRET=

# ─── JD URL fetching ───
FIRECRAWL_API_KEY=
PLAYWRIGHT_FALLBACK=true
