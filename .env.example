# ════════════════════════════════════════════════════════════
# RESUMAKER — Environment Configuration Template
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Production secrets live in /Volumes/Server_Data/secrets/
# NEVER commit .env to git.
# ════════════════════════════════════════════════════════════

# ─── Application ───
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

# ─── Database ───
DATABASE_URL=postgresql://resumaker:devpassword@localhost:5432/resumaker
DATABASE_POOL_MAX=20

# ─── Redis (rate limiting + cache) ───
REDIS_URL=redis://localhost:6379

# ─── Better Auth ───
BETTER_AUTH_SECRET=replace-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (get from respective consoles)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── LLM Providers ───
# Anthropic (default LLM)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional alternative providers (for premium tier)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# LLM configuration
DEFAULT_LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

# ─── AI Safety ───
PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

# ─── AWS ───
AWS_REGION=il-central-1
AWS_S3_BUCKET=resumaker-files-dev
AWS_S3_REGION=il-central-1

# ─── Stripe (infrastructure ready, payments disabled at launch) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ENABLED=false

# ─── Sentry ───
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Observability ───
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Job Description URL fetching ───
# Optional: Firecrawl for reliable scraping
FIRECRAWL_API_KEY=
# Fallback: Playwright headless (no API key needed)
PLAYWRIGHT_FALLBACK=true

# ─── Feature Flags ───
FEATURE_JOB_HUNTING_BETA=false
FEATURE_MULTI_LLM_CHOICE=false
FEATURE_COVER_LETTER=false
