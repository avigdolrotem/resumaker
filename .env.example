# ════════════════════════════════════════════════════════════
# RESUMAKER — Environment Configuration Template
# ────────────────────────────────────────────────────────────
# Production secrets live in GCP Secret Manager and are projected
# into pods at runtime by External Secrets Operator. This file
# documents every env var the app reads — values shown are
# placeholders. NEVER commit a populated .env.
# ════════════════════════════════════════════════════════════

# ─── Application ───
NODE_ENV=production
APP_URL=https://resumaker.co.il
# Mirror of APP_URL but baked into the client bundle (Better Auth client
# needs this at build time, not runtime). Same value as APP_URL.
NEXT_PUBLIC_APP_URL=https://resumaker.co.il
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

# ─── Database (Cloud SQL Postgres via Cloud SQL Connector) ───
# DATABASE_URL is optional and only used by local psql tooling
# (drizzle-kit migrations, direct psql). The app runtime exclusively
# uses the Cloud SQL Connector path below.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Cloud SQL Connector — required in every environment.
# Format: "project:region:instance" e.g. "resumaker-prod:europe-west1:resumaker-pg"
GCP_CLOUD_SQL_INSTANCE=
# IAM principal that connects to Postgres (service account email).
GCP_CLOUD_SQL_IAM_USER=
GCP_CLOUD_SQL_DATABASE=resumaker
# PRIVATE for GKE pods over VPC peering (production), PUBLIC for local
# dev via Cloud SQL Auth Proxy.
GCP_CLOUD_SQL_IP_TYPE=PRIVATE

# ─── Redis (Memorystore via External Secrets) ───
# Required. App fails closed on rate limits if Redis is unreachable.
REDIS_URL=

# ─── Better Auth ───
# Generate: `openssl rand -base64 48`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://resumaker.co.il

# Privacy: HMAC salt for hashing IPs in audit_log. Rotate yearly.
# Falls back to BETTER_AUTH_SECRET if unset.
# Generate: `openssl rand -base64 48`
IP_HASH_SALT=

# OAuth providers — optional, leave blank to disable the buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── LLM (Vercel AI Gateway) ───
# Single key fronting Claude / Gemini / GPT routing. In Vercel deployments
# this auto-resolves via OIDC and may be left blank; outside Vercel it is
# required.
AI_GATEWAY_API_KEY=

# Model identifiers MUST be in `provider/model` format.
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-6
FALLBACK_LLM_MODEL=anthropic/claude-haiku-4-5
PARSE_LLM_MODEL=anthropic/claude-haiku-4-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY_LIMIT=20

# ─── AI Safety ───
PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

# ─── File storage (GCS via Workload Identity) ───
GCS_BUCKET=

# ─── Payment provider ───
# 'none' | 'stripe' | 'lemonsqueezy'
# Defaults to 'none' so pricing page shows waitlist CTA.
PAYMENT_PROVIDER=none

# Stripe (only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PLUS_QUARTERLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_QUARTERLY=

# LemonSqueezy (only when PAYMENT_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PLUS_MONTHLY=
LEMONSQUEEZY_VARIANT_PLUS_YEARLY=
LEMONSQUEEZY_VARIANT_PLUS_QUARTERLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_QUARTERLY=

# ─── Email (Resend) ───
# Without RESEND_API_KEY the app logs emails to console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=noreply@resumaker.co.il

# ─── Observability (Sentry) ───
# Server-side errors — read at runtime from Secret Manager.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Client-side errors — baked at BUILD TIME. CI passes this via docker
# --build-arg from the `NEXT_PUBLIC_SENTRY_DSN` GitHub secret. Same value
# as SENTRY_DSN — Sentry DSNs are public-by-design.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Cron ───
# Generate: `openssl rand -base64 32`
CRON_SECRET=

# ─── JD URL fetching ───
FIRECRAWL_API_KEY=
PLAYWRIGHT_FALLBACK=true

# ─── Web Push / PWA notifications (VAPID) ───
# Generate keys: `npx web-push generate-vapid-keys`
# VAPID_SUBJECT is the mailto: or URL to contact (required by web-push spec).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@resumaker.co.il
