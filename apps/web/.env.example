NODE_ENV=development
APP_URL=http://localhost:3000
# Mirror of APP_URL baked into the client bundle at build time —
# Better Auth's React client reads this for the same-origin guard.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

DATABASE_URL=postgresql://resumaker:devpassword@localhost:5432/resumaker
DATABASE_POOL_MAX=10

# Optional: GCP Cloud SQL via IAM auth (used in production on GKE)
GCP_CLOUD_SQL_INSTANCE=
GCP_CLOUD_SQL_IAM_USER=
GCP_CLOUD_SQL_DATABASE=resumaker

REDIS_URL=redis://localhost:6379
# Production-only: PEM-encoded Memorystore server CA pinned for TLS.
# Local dev uses plain redis:// to the docker container — leave empty.
REDIS_CA_CERT=

BETTER_AUTH_SECRET=<replace-with-32+-char-secret>
BETTER_AUTH_URL=http://localhost:3000

# All LLM calls (both `anthropic/*` and `google/*` model strings) route
# through GCP Vertex AI via Application Default Credentials — there is
# no Gateway or direct-provider-API path, despite what older docs may
# have said. `gcloud auth application-default login` is required for
# local dev either way. Safe to leave set to the real prod project.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west1

# Model identifiers must be in `provider/model` format. As of 2026-07-18
# these all default to Gemini — the Anthropic publisher isn't yet
# enabled in this project's Vertex AI Model Garden (one-time Console
# action, see the long comment atop lib/llm/models.ts). Once that's
# done, DEFAULT_LLM_MODEL can go back to
# anthropic/claude-sonnet-4-5@20250929.
DEFAULT_LLM_MODEL=google/gemini-2.5-pro
FALLBACK_LLM_MODEL=google/gemini-2.5-flash
PARSE_LLM_MODEL=google/gemini-2.5-flash

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

# DEPRECATED — removed in upcoming Phase A scrub (full-GCP migration)
AWS_REGION=il-central-1
AWS_S3_BUCKET=resumaker-files-dev

LOG_LEVEL=info
LOG_FORMAT=pretty

PLAYWRIGHT_FALLBACK=true
