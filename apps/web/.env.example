NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

DATABASE_URL=postgresql://resumaker:devpassword@localhost:5432/resumaker
DATABASE_POOL_MAX=10

# Optional: GCP Cloud SQL via IAM auth (used in production on Vercel)
GCP_CLOUD_SQL_INSTANCE=
GCP_CLOUD_SQL_IAM_USER=
GCP_CLOUD_SQL_DATABASE=resumaker

REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=<replace-with-32+-char-secret>
BETTER_AUTH_URL=http://localhost:3000

ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

AWS_REGION=il-central-1
AWS_S3_BUCKET=resumaker-files-dev

LOG_LEVEL=info
LOG_FORMAT=pretty

PLAYWRIGHT_FALLBACK=true
