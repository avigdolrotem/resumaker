NODE_ENV=development
APP_URL=http://localhost:3000
# Mirror of APP_URL baked into the client bundle at build time —
# Better Auth's React client reads this for the same-origin guard.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Resumaker
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en

DATABASE_URL=postgresql://resumaker:devpassword@localhost:5432/resumaker
DATABASE_POOL_MAX=10

# Optional: GCP Cloud SQL via IAM auth (used in production on GKE)
GCP_CLOUD_SQL_INSTANCE=
GCP_CLOUD_SQL_IAM_USER=
GCP_CLOUD_SQL_DATABASE=resumaker

REDIS_URL=redis://localhost:6379
# Production-only: PEM-encoded Memorystore server CA pinned for TLS.
# Local dev uses plain redis:// to the docker container — leave empty.
REDIS_CA_CERT=

BETTER_AUTH_SECRET=<replace-with-32+-char-secret>
BETTER_AUTH_URL=http://localhost:3000

# AI provider (Vercel AI Gateway) — required in production
AI_GATEWAY_API_KEY=

# Vertex AI (Gemini path). For local dev these can be left set to the
# real prod values — Vertex calls only happen when the resolved model
# is a `google/...` one, and ADC (`gcloud auth application-default
# login`) is required either way. Safe defaults below.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west1

# Model identifiers must be in `provider/model` format
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-6
FALLBACK_LLM_MODEL=anthropic/claude-haiku-4-5
PARSE_LLM_MODEL=anthropic/claude-haiku-4-5

# Optional: direct provider key override (Gateway falls back to this)
ANTHROPIC_API_KEY=sk-ant-...

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

PROMPT_INJECTION_DETECTION=strict
MAX_INPUT_LENGTH_CHARS=20000
RATE_LIMIT_PER_USER_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=20

# DEPRECATED — removed in upcoming Phase A scrub (full-GCP migration)
AWS_REGION=il-central-1
AWS_S3_BUCKET=resumaker-files-dev

LOG_LEVEL=info
LOG_FORMAT=pretty

PLAYWRIGHT_FALLBACK=true
