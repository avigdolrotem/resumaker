{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@resumaker/shared": ["../../packages/shared/src"],
      "@resumaker/ui": ["../../packages/ui/src"],
      "@resumaker/ai-safety": ["../../packages/ai-safety/src"]
    },
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
