# Don't upload these to Vercel — they're either huge, regenerated by
# Vercel's build, or specific to local-dev / other deploy targets.
#
# Vercel respects .gitignore too, but .vercelignore wins for upload-time
# exclusions even on files tracked in git (the OpenTofu state is the
# specific case we care about).

# Heavy directories that Vercel rebuilds anyway
node_modules
.next
.turbo
dist
build
.cache

# Other-deploy artifacts — never needed by Vercel
infra/
.github/
docs/
tests/e2e/
playwright-report/
test-results/

# Local dev / agent scratch
.vercel
.env*
*.log

# Don't upload other workspace artifacts (Vercel only builds apps/web)
packages/*/dist
packages/*/node_modules
apps/*/node_modules
apps/*/.next
