resource "google_redis_instance" "main" {
  project        = var.project_id
  name           = "resumaker-${var.env}-redis"
  region         = var.region
  memory_size_gb = var.memory_size_gb
  redis_version  = "REDIS_7_2"
  tier           = var.env == "prod" ? "STANDARD_HA" : var.tier

  authorized_network      = var.network_id
  connect_mode            = "PRIVATE_SERVICE_ACCESS"
  transit_encryption_mode = "SERVER_AUTHENTICATION"

  # AUTH adds a password requirement on top of network-level isolation.
  # Without it, any pod with VPC routing to the instance can connect
  # anonymously. Even with the NetworkPolicy default-deny, that's
  # one mis-applied chart away from cluster-wide cache access.
  #
  # The auth string is generated by GCP and exposed via the
  # `auth_string` attribute — the operator should pipe it into the
  # `redis-auth` Secret Manager entry and reference it from the app
  # via REDIS_URL=rediss://<auth>@host:port.
  #
  # Closes Phase 4 finding G.6.
  auth_enabled = true

  depends_on = [var.private_services_connection_ready]
}
